# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# ---- SS4 ----
SS4_SERVER=ss4
SS4_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Leave blank for Windows authentication (runs as you).
# Set both to use a SQL login, e.g. a dedicated read-only login for the agent.
SS4_USER=
SS4_PASSWORD=

# ---- Business Central ----
# Tenant and client id are in MorrowAPI's appsettings.json ("BusinessCentral").
# Ideally use a separate Entra app granted only read permission sets in BC.
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=

# Default target. Company is BC's internal name (e.g. "AB-Test 20260210"),
# not the display name users see.
BC_ENVIRONMENT=
BC_COMPANY=
BC_COMPANY_ID=

# Optional second target, read with BcTarget.from_env("BCUAT")
# BCUAT_ENVIRONMENT=MorrowUAT_04292026
# BCUAT_COMPANY=AB-Test 20260210
# BCUAT_COMPANY_ID=c463254a-7c06-f111-8405-6045bdd66a89
